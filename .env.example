# CampusAgent environment template.
#
# Copy to `.env` and fill in real values. `.env` is gitignored -- keys must never
# be committed or pasted into chat. If a key has been exposed, revoke it in the
# Volcengine Ark console and issue a new one; that is cheaper than the alternative.
#
#   cp .env.example .env

# DeepSeek API key, used for the conversational model. Referenced from the
# provider config as the literal "$DEEPSEEK_API_KEY" (see campuscue/provision.py)
# so the key itself never lands in data/cmd_config.json.
DEEPSEEK_API_KEY=

# Model name, e.g. deepseek-chat. Not a secret. Defaults to deepseek-chat.
DEEPSEEK_MODEL=

# Volcengine Ark API key for automatic task extraction. Messages rejected by
# the local L1 filter stay on this machine; candidates that pass L1 are sent to
# Ark with their group/sender/time context. The key stays out of config files.
ARK_API_KEY=

# Ark inference endpoint id, e.g. ep-20260101120000-abcde. In the
# OpenAI-compatible API this goes in the `model` field. Not a secret.
ARK_MODEL=

# Optional: a cheaper endpoint used only for the L2 extraction step. Extraction
# is a fixed-format task and does not need a frontier model, so splitting this
# from the conversational model keeps the per-message cost down. Falls back to
# ARK_MODEL when unset.
ARK_EXTRACT_MODEL=

# --- Optional overrides ---------------------------------------------------
# All of these have safe defaults; only set them when the default does not fit.

# The demo session shown on the board before any QQ group has been watched.
# Defaults to "aiocqhttp:GroupMessage:demo-7788".
CAMPUSCUE_DEMO_UMO=

# Where NapCat is installed. Defaults to <project>/data/napcat.
CAMPUSCUE_NAPCAT_DIR=

# OneBot reverse-WebSocket address and port astrbot listens on and NapCat dials
# back to. Defaults to 127.0.0.1:6199. Only change the host if NapCat runs on
# another machine; keep the port in sync with what 启动课讯.bat expects.
CAMPUSCUE_ONEBOT_HOST=
CAMPUSCUE_ONEBOT_PORT=

# Optional token for the reverse-WebSocket handshake. Both ends run on
# 127.0.0.1 by default, where an empty token is safe; set it if the host is
# exposed beyond loopback.
CAMPUSCUE_ONEBOT_TOKEN=

# Put the campus board and setup API behind the dashboard's login. The packaged
# product binds to 127.0.0.1 by default. Set this to 1 before deliberately
# changing dashboard.host to a non-loopback address.
CAMPUSCUE_REQUIRE_AUTH=
