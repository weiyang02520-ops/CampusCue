# CampusCue V2 local demo configuration. Replace placeholders locally only.
CAMPUSCUE_TASK_PIPELINE=1
CAMPUSCUE_DB_PATH=./data/demo.db
CAMPUSCUE_TIMEZONE=Asia/Shanghai

# REST + WebUI backend; keep loopback for a local demo.
CAMPUSCUE_API=1
CAMPUSCUE_API_HOST=127.0.0.1
CAMPUSCUE_API_PORT=6200
CAMPUSCUE_REQUIRE_AUTH=1
CAMPUSCUE_API_TOKEN=<local-random-token>

# Agent and reminders.
CAMPUSCUE_AGENT=1
CAMPUSCUE_REMINDERS=1
CAMPUSCUE_REMINDER_DELIVERY=noop

# OneBot/NapCat reverse WebSocket. Use a local test account/group only.
CAMPUSCUE_ONEBOT_HOST=127.0.0.1
CAMPUSCUE_ONEBOT_PORT=6199
CAMPUSCUE_ONEBOT_PATH=/ws
CAMPUSCUE_ONEBOT_TOKEN=<local-onebot-token>

# Provider configuration is stored through the existing Provider API or local
# operator setup. Never put a provider key in this file or in Git.
